# Thin CI layer over the EXISTING installed-package testbed. No credentials,
# host mounts, provider binaries or additional package installation.
ARG TESTBED_IMAGE
FROM ${TESTBED_IMAGE}
COPY runner.mjs /opt/softwareteam-testbed/runner.mjs
COPY scenarios/ /opt/softwareteam-testbed/scenarios/
COPY library/ /opt/softwareteam-testbed/library/
CMD ["node", "/opt/softwareteam-testbed/runner.mjs", "healthy"]
